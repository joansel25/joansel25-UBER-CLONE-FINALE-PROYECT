<?xml version="1.0" encoding="utf-8"?>
<!--
  Allows cleartext HTTP traffic in debug builds only.
  Required for Android emulator to reach the local dev backend at 10.0.2.2:5000
-->
<network-security-config>
  <domain-config cleartextTrafficPermitted="true">
    <!-- Android emulator host alias for the development machine -->
    <domain includeSubdomains="false">10.0.2.2</domain>
    <!-- Physical device USB debugging -->
    <domain includeSubdomains="false">localhost</domain>
    <domain includeSubdomains="false">127.0.0.1</domain>
  </domain-config>
</network-security-config>
