<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Desarrollo: permite HTTP cleartext a cualquier host local.
        Emulador Android → usa 10.0.2.2 como API_URL
        Dispositivo físico → usa la IP WiFi del PC (ej: 192.168.1.x)
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>