# Copy this file to .env and fill in the real values
# .env is gitignored — never commit real keys

# Backend API — Android emulator uses 10.0.2.2 to reach host localhost
API_URL=http://10.0.2.2:5000/api

# Stripe publishable key (pk_test_... from Stripe dashboard)
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Google Maps API Key (same key used in backend)
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_KEY
