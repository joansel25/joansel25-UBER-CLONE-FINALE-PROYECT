# Copy this file to .env and fill in the real values
# .env is gitignored — never commit real keys

# Backend API
# Android emulator → 10.0.2.2 reaches the host machine's localhost
# iOS simulator    → localhost works directly
API_URL=http://10.0.2.2:5000/api

# Stripe PUBLISHABLE key (pk_test_... from Stripe dashboard)
# This is NOT the backend secret key (sk_test_...) — it is safe to use on the client
# Used to initialize StripeProvider in App.js
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Google Maps — reference only
# The real integration is NATIVE, not from .env:
#   Android: android/app/src/main/AndroidManifest.xml  (meta-data geo.API_KEY)
#   iOS:     ios/<AppName>/AppDelegate.mm              (GMSServices.provideAPIKey)
# Use the same key as the backend. Make sure Maps SDK for Android
# and Maps SDK for iOS are enabled in Google Cloud Console.
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_KEY
